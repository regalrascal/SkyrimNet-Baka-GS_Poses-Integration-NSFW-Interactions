# ───────────── Papyrus source ─────────────
# Ship OUR scripts (so others can read / improve / fork the logic), but NOT the third-party
# compile stubs (Acheron, SexLabFramework, SkyrimNetApi, MfgConsoleFunc, OThread, SKI_ConfigBase, …)
# which are minimal local declarations of other mods' APIs.
Scripts/Source/*.psc
!Scripts/Source/SkyrimNet_Baka*.psc
!Scripts/Source/SkyrimNet_Anim*.psc
!Scripts/Source/SNBakaUI.psc
!Scripts/Source/SNAnimGSUI.psc

# ───────────── Third-party compile stubs ─────────────
# These are framework API stubs for local compilation (SexLab, OStim, MfgConsole, Acheron,
# SlaveTats, SPE, AELStruggle). They live in the working repos but must NOT ship in the
# public fork or any release zip — they are other authors' code.
tools/

# ───────────── Build tools / artifacts (NOT shipped) ─────────────
compile.bat
*.pdb
*.log

# ───────────── Local backups ─────────────
*.zip
*.rar
*.7z
*.bak*
*.dot
*.sha256
Scripts/pex_backup_*/

# ───────────── Mod-manager / editor / agent local metadata ─────────────
meta.ini
.vscode/
.claude/

# ───────────── OS cruft ─────────────
Thumbs.db
desktop.ini
.DS_Store

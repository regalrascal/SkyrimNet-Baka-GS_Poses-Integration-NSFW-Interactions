<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<!-- Authored REV-68 Phase C (2026-10-02); structure verified against two
	     known-working local FOMODs (SeverActions 3.9.14, IntelEngine 3.5.0.1)
	     same session - canonical qconsulting schema URL. REV-107b (2026-10-13):
	     DeD_Framework.esp added to the required set (silent-wizard-drop fix).
	     REV-108 (2026-10-13): v2 REAL MODULE TOGGLES - the required set is now
	     the FRAMEWORK only; every module is a real file toggle below. File-set
	     basis: era doc module map (REV-88 1.1) productized per the S1-S4
	     unlock (REV-103/104/105/106/107). Scripts/ ships in full in the
	     framework (the Papyrus script core is one link-time island - the MCM
	     and the motherboard reference every module script by name, so scripts
	     are always installed; module options toggle files only: esp, DLL,
	     content layer, assets). moduleImage syntax verified against 133 real
	     FOMODs in the local downloads set (e.g. Additional Clockwork 3.0.5).
	     Player-facing titles per the REV-68 section-7 rider; technical paths
	     (folder names, manifest id regalrascal.baka-gs-integration) are legacy
	     Beta 25 load-bearing. -->
	<moduleName>Delectatio et Dominium (0.3.0-alpha)</moduleName>
	<moduleImage path="fomod\images\Delectatio_et_Dominium_Cover.jpg" showImage="true" showFade="true" height="-1"/>
	<requiredInstallFiles>
		<!-- FRAMEWORK (always installed): the MCM host esp + the core the MCM,
		     menus, and the shared interaction pack need. Every module's
		     remaining files toggle below. -->
		<file source="DeD_Framework.esp" destination="DeD_Framework.esp"/>
		<folder source="Scripts" destination="Scripts"/>
		<file source="SKSE/Plugins/SNBaka_Offsets.ini" destination="SKSE/Plugins/SNBaka_Offsets.ini"/>
		<file source="SKSE/Plugins/SkyrimNet_BakaIntegration.dll" destination="SKSE/Plugins/SkyrimNet_BakaIntegration.dll"/>
		<!-- REV-113b (2026-10-15): the framework service DLL joins the required set (central
		     state store + cosave serialization + single tick scheduler + event pump; the
		     cum-v2 backing store). Its companion psc/pex ride the Scripts folder below (the
		     script core ships in full). -->
		<file source="SKSE/Plugins/DeDService.dll" destination="SKSE/Plugins/DeDService.dll"/>
		<folder source="SKSE/Plugins/SkyrimNet/external/regalrascal.baka-gs-integration" destination="SKSE/Plugins/SkyrimNet/external/regalrascal.baka-gs-integration"/>
		<folder source="Sound" destination="Sound"/>
		<folder source="Interface" destination="Interface"/>
		<folder source="PrismaUI/views/SNBaka_Menu" destination="PrismaUI/views/SNBaka_Menu"/>
		<folder source="PrismaUI/views/SNBaka_ExecuteConfirm" destination="PrismaUI/views/SNBaka_ExecuteConfirm"/>
		<folder source="PrismaUI/views/SNBaka_Hud" destination="PrismaUI/views/SNBaka_Hud"/>
		<folder source="PrismaUI/views/GSAnim_Menu/images" destination="PrismaUI/views/GSAnim_Menu/images"/>
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Delectatio et Dominium">
			<!-- 2.2 Registry-based prerequisite detection (honest capability set):
			     fileDependency inside per-plugin dependencyType patterns checks the
			     files MO2's modlist exposes to the installer (Active/Inactive/Missing
			     state); NO game-state detection exists at install time - module
			     prerequisites stay RUNTIME presence-gated (the Installed() probes).
			     pluginDependency/conditionalFileInstaller deliberately NOT used:
			     census of 264 real FOMODs in the local downloads set = 0 uses, no
			     local precedent. Plugin type names used: Required/Recommended/
			     Optional/NotUsable - census-verified (4436/1942/40/388 uses);
			     "Warning"/"Error" type names appear in ZERO of 264 real FOMODs and
			     are therefore NOT used (omitted over guess).
			     REV-108b (2026-10-13) FIXES: (1) group type SelectAll was the
			     unclickable-toggles bug root cause (SelectAll = all options must
			     be selected = checkboxes locked; corpus census: SelectAll
			     co-occurs with Required plugins ONLY, 10/10; every deselectable
			     module group in the corpus is SelectAny, 437 precedents -
			     SeverActions 3.9.14/4.3.0 "Select which action modules to
			     install:" is the class match) -> group type is now SelectAny.
			     (2) The anchor is retyped Required -> Recommended (SelectAny+
			     Required = 0 corpus precedents; the anchor installs nothing -
			     the framework rides requiredInstallFiles regardless of its
			     checkbox) and its tooltip sentence amended accordingly (the
			     factual-corruption minimum, registered).
			     (3) USER RULING (C4 supersession, dated 2026-10-13): the
			     "Arousal Framework Check" plugin is REMOVED - the C4 pre-check
			     implemented surface of record is now README recommendation +
			     the runtime chain (Reborn first, then SL Aroused, then neutral;
			     Reborn bundles SexLabAroused.esm so filename detection cannot
			     distinguish Reborn-only from both - honest-limit text rides the
			     README). -->
			<optionalFileGroups order="Explicit">
				<group name="Modules" type="SelectAny">
					<plugins order="Explicit">
						<plugin name="Framework (always installed)">
							<description>The heart of DeD: the MCM, the interaction menus, the service DLL that keeps every module's state save-safe, and the shared content pack the LLM reads. One framework, every module hanging off it - and it never gets in the way.

Always installed regardless of this checkbox; the module options below are the real file toggles.</description>
							<files/>
							<typeDescriptor>
								<type name="Recommended"/>
							</typeDescriptor>
						</plugin>
						<plugin name="Baka Interactions">
							<description>The interaction core: flirt, harass, escalate, capture, spank - affectionate, forced, and sexual actions through the Interact power, with resistance, struggle, and slavery. A background daemon (Mephala / Molag Bal modes) lets dominant NPCs escalate on their own initiative. Every emergent NSFW moment in DeD starts here.</description>
							<files>
								<file source="SkyrimNet_BakaIntegration.esp" destination="SkyrimNet_BakaIntegration.esp"/>
							</files>
							<typeDescriptor>
								<type name="Recommended"/>
							</typeDescriptor>
						</plugin>
						<plugin name="GS Poses">
							<description>Solo posing, made ambient: a PrismaUI pose grid for you or any targeted NPC, plus Sanguine Mode, the background daemon that puts idle NPCs into mood-fitting poses - the LLM picks both the pose and the exact move from live scene context. Sheogorath Mode raises the intensity when you want a livelier room.</description>
							<files>
								<file source="SkyrimNet_AnimationsGS.esp" destination="SkyrimNet_AnimationsGS.esp"/>
								<file source="SKSE/Plugins/SNAnimGS_UI.dll" destination="SKSE/Plugins/SNAnimGS_UI.dll"/>
								<folder source="SKSE/Plugins/SkyrimNet/external/regalrascal.gs-poses" destination="SKSE/Plugins/SkyrimNet/external/regalrascal.gs-poses"/>
								<file source="PrismaUI/views/GSAnim_Menu/index.html" destination="PrismaUI/views/GSAnim_Menu/index.html"/>
								<file source="PrismaUI/views/GSAnim_Menu/poses.js" destination="PrismaUI/views/GSAnim_Menu/poses.js"/>
							</files>
							<typeDescriptor>
								<type name="Recommended"/>
							</typeDescriptor>
						</plugin><!-- REV-159 F-1 (S181 finding, delete-over-restore ruled): the Cum
     Detection group is DELETED. Its only file target
     (the cum-detection package folder, consolidated into the shared pack)
     was consolidated into regalrascal.baka-gs-integration at
     REV-134d (commit fb36b40) and the folder exists in no dist since
     [REV-134c] - the group installed nothing and its description no
     longer matched reality in either direction. A stub group would
     re-split the R1 grouping (delete-over-restore). The cum module
     itself is framework-carried (Scripts + the shared pack); its
     runtime gate is the MCM "Cum Cues Module Toggle" plus
     OCum/SexLab presence. --><plugin name="FHU Inflation">
							<description>Fill Her Up, narrated: belly inflation cues as it happens - swelling on level-up, release on level-down, creature fills - with ambient follow-up narration on by default, and OStim scenes driving their own fills. Inflation becomes part of the story instead of a silent widget.

Unchecking this removes the cue pack only; the module's logic stays installed and simply idles - nothing breaks either way.</description>
							<files>
								<folder source="SKSE/Plugins/SkyrimNet/external/regalrascal.fhu-inflation" destination="SKSE/Plugins/SkyrimNet/external/regalrascal.fhu-inflation"/>
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional"/>
									<patterns>
										<pattern>
											<dependencies>
												<fileDependency file="sr_FillHerUp.esp" state="Active"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
						<plugin name="SlaveTats">
							<description>Marks that linger: degradation tattoos - spank marks, tears, drool, the defeated look - applied by the LLM with in-character reactions, plus ambient rolls narrating who notices the marks a character is wearing. The body keeps the story.

Unchecking this removes the tattoo assets and the set-picker UI only; the content layer stays installed and inert - nothing breaks either way.</description>
							<files>
								<folder source="textures/actors/character/SlaveTats" destination="textures/actors/character/SlaveTats"/>
								<file source="PrismaUI/views/SNSlaveTats_Menu/index.html" destination="PrismaUI/views/SNSlaveTats_Menu/index.html"/>
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional"/>
									<patterns>
										<pattern>
											<dependencies>
												<fileDependency file="SlaveTats.esp" state="Active"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
						<plugin name="Acheron Bridge">
							<description>Defeat with consequences: the downed-state bridge between Acheron and DeD - downed actors get the interact menu, the Downed State MCM page, and capped consequence cues. Losing a fight becomes a scene, not a game over.</description>
							<files>
								<file source="SkyrimNet_AcheronIntegration.esp" destination="SkyrimNet_AcheronIntegration.esp"/>
								<folder source="SKSE/Acheron/Consequences" destination="SKSE/Acheron/Consequences"/>
								<folder source="SKSE/Plugins/SkyrimNet/external/around906.acheron-integration" destination="SKSE/Plugins/SkyrimNet/external/around906.acheron-integration"/>
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional"/>
									<patterns>
										<pattern>
											<dependencies operator="Or">
												<fileDependency file="Acheron.esm" state="Active"/>
												<fileDependency file="Acheron.esp" state="Active"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>

